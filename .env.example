# Bu dosya ornek/sablon dosyadir ve git'e commit edilir.
# Gercek degerler .env dosyasina yazilir (.env git'e ASLA commit edilmez).
# Kurulum: cp .env.example .env

# Uygulama adi
APP_NAME=kerimbalci-com

# Calisma ortami: development | staging | production
ENVIRONMENT=development

# Debug modu: true ise log seviyesi otomatik DEBUG olur
DEBUG=false

# Log seviyesi: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# LLM-as-judge: degerlendirme (eval) icin kullanilacak Anthropic modeli
JUDGE_MODEL=claude-opus-5-5

# Test edilecek chatbot'un Hugging Face Space adresi
HF_CHATBOT_URL=https://kullanici-adi-space-adi.hf.space

# Chatbot'un Gradio API endpoint adi (varsayilan: /cevapla)
CHATBOT_API_ENDPOINT=/cevapla

# Factuality hakem seviyesi: 1=basic, 2=intermediate, 3=advanced (judges/factuality_judge/)
FACTUALITY_JUDGE_LEVEL=3

# Factuality eval esik degeri (0-1). Bos birakilirsa hakem YAML'indaki threshold kullanilir.
EVAL_FACTUALITY_THRESHOLD=

# Eval runner: ayni anda degerlendirilen case sayisi (chatbot + hakem istekleri)
EVAL_CONCURRENCY=4

# Eval runner: sadece bu tag'lere sahip case'ler calisir (virgulle; bos = hepsi)
# Factuality icin tag = kategori: direct_fact,false_premise,unanswerable,time_sensitive
EVAL_TAGS=

# Eval runner kalite kapisi: gecen case orani bunun altindaysa kosu basarisiz (0-1).
# Hata alan case'ler de basarisiz sayilir.
EVAL_MIN_PASS_RATE=0.85

# Rapor karsilastirma (python -m kerimbalci_com.evals.compare): durumu ayni kalan
# case'lerde puan farki bu esigin ustundeyse "puani degisen" olarak listelenir
EVAL_COMPARE_MIN_DELTA=0.2

# Eval runner: JSON raporlarin yazilacagi klasor (proje kokune gore)
EVAL_REPORT_DIR=reports

# Dis HTTP istekleri icin zaman asimi, saniye (baglanti testleri ve site taramasi)
HTTP_TIMEOUT=30

# Dataset uretimi: taranacak site ve indirilen metinlerin klasoru (proje kokune gore, git'e girmez)
SITE_URL=https://kerimbalci.com
SITE_WORKDIR=.cache/site
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; kerimbalci-com-eval)

# Chatbot istemcisi: tek soru icin zaman asimi (sn), hata/zaman asiminda yeniden deneme
# sayisi ve ilk bekleme suresi (sn; her denemede iki katina cikar: 2, 4, 8 ...)
CHATBOT_TIMEOUT=60
CHATBOT_MAX_RETRIES=2
CHATBOT_RETRY_BACKOFF=2

# Hugging Face erisim token'i (gercek degeri .env dosyasina yaz)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Anthropic API anahtari (gercek degeri .env dosyasina yaz)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Confident AI proje anahtari (deepeval sonuclarini izleme platformu)
# https://app.confident-ai.com -> Settings -> Project API Key
CONFIDENT_API_KEY=confident_xxxxxxxxxxxxxxxxxxxx
