# This file is a template and is committed to git.
# Real values go into the .env file (.env is NEVER committed to git).
# Setup: cp .env.example .env

# Application name
APP_NAME=kerimbalci-com

# Environment: development | staging | production
ENVIRONMENT=development

# Debug mode: when true, the log level is automatically DEBUG
DEBUG=false

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# LLM-as-judge: Anthropic model used for evaluation
JUDGE_MODEL=claude-opus-5-5

# Hugging Face Space URL of the chatbot under test
HF_CHATBOT_URL=https://username-space-name.hf.space

# Gradio API endpoint name of the chatbot (default: /cevapla)
CHATBOT_API_ENDPOINT=/cevapla

# Factuality judge level: 1=basic, 2=intermediate, 3=advanced (judges/factuality_judge/)
FACTUALITY_JUDGE_LEVEL=3

# Hallucination judge level: 1=basic, 2=intermediate, 3=advanced (judges/hallucination_judge/)
HALLUCINATION_JUDGE_LEVEL=3

# Hallucination eval threshold (0-1). If empty, the threshold from the judge YAML is used.
EVAL_HALLUCINATION_THRESHOLD=

# Second metric in the factuality and hallucination suites (Expected Behavior: language, concision, tone, framing).
# When false, only the main metric is measured (judge cost roughly halves).
EVAL_EXPECTED_BEHAVIOR=true

# Factuality eval threshold (0-1). If empty, the threshold from the judge YAML is used.
EVAL_FACTUALITY_THRESHOLD=

# Eval runner: number of cases evaluated at the same time (chatbot + judge requests)
EVAL_CONCURRENCY=4

# Eval runner: only cases with these tags run (comma-separated; empty = all)
# For factuality, tag = category: direct_fact,false_premise,unanswerable,time_sensitive
# For hallucination: fabricated_detail,fake_attribution,entity_confusion,unsupported_addition
EVAL_TAGS=

# Eval runner quality gate: the run fails if the pass rate is below this (0-1).
# Errored cases also count as failures.
EVAL_MIN_PASS_RATE=0.85

# Report comparison (python -m kerimbalci_com.evals.compare): cases whose status is
# unchanged are listed as "score changed" when the score delta exceeds this threshold
EVAL_COMPARE_MIN_DELTA=0.2

# Eval runner: folder for the JSON reports (relative to the project root)
EVAL_REPORT_DIR=reports

# Timeout for external HTTP requests, seconds (connection tests and site crawl)
HTTP_TIMEOUT=30

# Dataset generation: site to crawl and folder for the downloaded texts (relative to the project root, not in git)
SITE_URL=https://kerimbalci.com
SITE_WORKDIR=.cache/site
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; kerimbalci-com-eval)

# Chatbot client: timeout per question (s), number of retries on error/timeout
# and the initial backoff (s; doubles on every attempt: 2, 4, 8 ...)
CHATBOT_TIMEOUT=60
CHATBOT_MAX_RETRIES=2
CHATBOT_RETRY_BACKOFF=2

# Hugging Face access token (put the real value in .env)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Anthropic API key (put the real value in .env)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Confident AI project key (platform that tracks deepeval results)
# https://app.confident-ai.com -> Settings -> Project API Key
CONFIDENT_API_KEY=confident_xxxxxxxxxxxxxxxxxxxx
